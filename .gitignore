/target
/dist
**/*.rs.bk

# Cargo.lock is intentionally committed: kyberfrog is a deployable application
# and we want reproducible builds.

# Blackmagic drivers + local .deb packages are license-gated / large binaries,
# never commit them — only installer/build-usb.sh + installer/VERSION are tracked.
installer/extra-debs/*.deb
installer/*.iso
installer/VERSION.local
